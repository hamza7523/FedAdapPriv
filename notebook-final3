    "_client_sigma_cache = {}\n",
    "\n",
    "\n",
    "def reset_accountants():\n",
    "    global client_accountants, _client_sigma_cache\n",
    "    client_accountants  = {cid: RDPAccountant() for cid in range(NUM_CLIENTS)}\n",
    "    _client_sigma_cache = {}\n",
