    "# ── CELL: Ablation Study + Multi-Seed Validation ──────────────────────────\n",
    "\n",
    "import numpy as np\n",
    "import torch\n",
    "import json, copy\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "ABLATION_SEEDS   = [0, 7, 42, 123, 999]\n",
    "ABLATION_EPSILON = 4.0\n",
    "ABLATION_ROUNDS  = 30\n",
    "DIRICHLET_ALPHA  = 0.5\n",
    "\n",
    "# ── Repartition (fixed — Client B absorbs all remaining) ──────────────────\n",
    "def repartition_features(all_feat, all_lab, seed):\n",
    "    rng = np.random.RandomState(seed)\n",
    "\n",
    "    # Per-class index pools, shuffled with this seed\n",
    "    pools = {}\n",
    "    for label in range(N_CLASSES):\n",
    "        idx = np.where(all_lab == label)[0]\n",
    "        idx = idx[rng.permutation(len(idx))]\n",
    "        pools[label] = list(idx)\n",
    "\n",
    "    assigned = {0: [], 1: [], 2: []}\n",
    "\n",
    "    # ── Client C: VP-dominant (class 3), capped at VP_count/0.70 ──────────\n",
    "    vp_count     = len(pools[3])\n",
    "    client_c_max = int(vp_count / 0.70)\n",
    "\n",
    "    assigned[2].extend(pools[3])\n",
    "    pools[3] = []\n",
    "    c_remaining = client_c_max - len(assigned[2])\n",
    "    non_vp = [l for l in range(N_CLASSES) if l != 3]\n",
    "    if c_remaining > 0:\n",
    "        props = rng.dirichlet([DIRICHLET_ALPHA] * len(non_vp))\n",
    "        for i, label in enumerate(non_vp):\n",
    "            n_take = min(int(round(props[i] * c_remaining)), len(pools[label]))\n",
    "            assigned[2].extend(pools[label][:n_take])\n",
    "            pools[label] = pools[label][n_take:]\n",
    "    assigned[2] = assigned[2][:client_c_max]   # hard cap — preserves ~70% VP\n",
    "\n",
    "    # ── Client A: COVID-dominant (class 0) ────────────────────────────────\n",
    "    assigned[0].extend(pools[0])\n",
    "    pools[0] = []\n",
    "    non_dom_need = int(len(assigned[0]) / 0.70) - len(assigned[0])\n",
    "    other = [l for l in range(N_CLASSES) if l != 0 and len(pools[l]) > 0]\n",
    "    if other and non_dom_need > 0:\n",
    "        props = rng.dirichlet([DIRICHLET_ALPHA] * len(other))\n",
    "        for i, label in enumerate(other):\n",
    "            n_take = min(int(round(props[i] * non_dom_need)), len(pools[label]))\n",
    "            assigned[0].extend(pools[label][:n_take])\n",
    "            pools[label] = pools[label][n_take:]\n",
    "\n",
    "    # ── Client B: absorbs all remaining (Lung Opacity dominant naturally) ──\n",
    "    for label in range(N_CLASSES):\n",
    "        assigned[1].extend(pools[label])\n",
    "        pools[label] = []\n",
    "\n",
    "    feats_out  = {cid: all_feat[np.array(assigned[cid])] for cid in range(3)}\n",
    "    labels_out = {cid: all_lab[np.array(assigned[cid])]  for cid in range(3)}\n",
    "    return feats_out, labels_out\n",
    "\n",
    "\n",
    "# ── Sanity check before running (verify VP% is ~70% for Client C) ─────────\n",
    "print(\"Repartition sanity check:\")\n",
    "for s in ABLATION_SEEDS:\n",
    "    f, l = repartition_features(_all_feat, _all_lab, s)\n",
    "    vp_c = 100 * (l[2] == 3).sum() / len(l[2])\n",
    "    vp_a = 100 * (l[0] == 0).sum() / len(l[0])\n",
    "    print(f\"  seed={s}  A={len(f[0])} (COVID={vp_a:.1f}%)  \"\n",
    "          f\"B={len(f[1])}  C={len(f[2])} (VP={vp_c:.1f}%)\")\n",
    "print()\n",
    "\n",
    "\n",
    "# ── Core variant runner ───────────────────────────────────────────────────\n",
    "def _run_variant_core(variant_name, warmstart_w, seed, epsilon, num_rounds):\n",
    "    torch.manual_seed(seed)\n",
    "    np.random.seed(seed)\n",
    "    _client_sigma_cache.clear()\n",
    "    reset_accountants()\n",
    "\n",
    "    if variant_name == 'fixed':\n",
    "        h = run_fixed_dp_fedavg(\n",
    "            warmstart_w,\n",
    "            epsilon_total = epsilon,\n",
    "            num_rounds    = num_rounds,\n",
    "            verbose       = False,\n",
    "        )\n",
    "    else:\n",
    "        original_conv  = globals().get('compute_alpha_conv')\n",
    "        original_round = globals().get('compute_alpha_round')\n",
    "\n",
    "        if variant_name == 'vol':\n",
    "            globals()['compute_alpha_conv']  = lambda deficiency, lam=LAMBDA: 1.0\n",
    "            globals()['compute_alpha_round'] = lambda r, R=NUM_ROUNDS: 1.0\n",
    "        elif variant_name == 'vol_round':\n",
    "            globals()['compute_alpha_conv']  = lambda deficiency, lam=LAMBDA: 1.0\n",
    "\n",
    "        h = run_federated_adaptive(\n",
    "            warmstart_w,\n",
    "            epsilon_total = epsilon,\n",
    "            num_rounds    = num_rounds,\n",
    "            verbose       = False,\n",
    "        )\n",
    "\n",
    "        if original_conv  is not None: globals()['compute_alpha_conv']  = original_conv\n",
    "        if original_round is not None: globals()['compute_alpha_round'] = original_round\n",
    "\n",
    "    acc, f1, pf = _eval_best(h)\n",
    "    return float(acc), float(f1), pf.tolist()\n",
    "\n",
    "\n",
    "# ── Wrapper: repartitions globals before each run ─────────────────────────\n",
    "def run_ablation_variant(variant_name, warmstart_w, seed, epsilon, num_rounds):\n",
    "    global client_features, client_labels, client_sizes, n_max, CLASS_WEIGHTS_TENSOR\n",
    "\n",
    "    f, l = repartition_features(_all_feat, _all_lab, seed)\n",
    "    client_features = f\n",
    "    client_labels   = l\n",
    "    client_sizes    = {cid: len(f[cid]) for cid in range(NUM_CLIENTS)}\n",
    "    n_max           = max(client_sizes.values())\n",
    "    all_tr_lab      = np.concatenate([l[c] for c in range(NUM_CLIENTS)])\n",
    "    cc              = np.bincount(all_tr_lab, minlength=N_CLASSES)\n",
    "    total           = cc.sum()\n",
    "    CLASS_WEIGHTS_TENSOR = torch.tensor(\n",
    "        [total / (N_CLASSES * c) if c > 0 else 0.0 for c in cc],\n",
    "        dtype=torch.float32\n",
    "    )\n",
    "\n",
    "    # Partition summary\n",
    "    for cid in range(NUM_CLIENTS):\n",
    "        lab     = l[cid]\n",
    "        vp_pct  = 100 * (lab == 3).sum() / len(lab)\n",
    "        cov_pct = 100 * (lab == 0).sum() / len(lab)\n",
    "        lo_pct  = 100 * (lab == 1).sum() / len(lab)\n",
    "        print(f\"    Client {['A','B','C'][cid]}: n={len(lab)}  \"\n",
    "              f\"VP={vp_pct:.1f}%  COVID={cov_pct:.1f}%  LO={lo_pct:.1f}%\")\n",
    "\n",
    "    return _run_variant_core(variant_name, warmstart_w, seed, epsilon, num_rounds)\n",
    "\n",
    "\n",
    "# ── Variants ──────────────────────────────────────────────────────────────\n",
    "VARIANTS = [\n",
    "    ('fixed',     'Fixed DP-FedAvg'),\n",
    "    ('vol',       'α_vol only'),\n",
    "    ('vol_round', 'α_vol × α_round'),\n",
    "    ('full',      'α_vol × α_conv × α_round  (ours)'),\n",
    "]\n",
    "\n",
    "ablation_results = {name: {'acc': [], 'f1': [], 'pf': []} for name, _ in VARIANTS}\n",
    "\n",
    "print(f\"Ablation Study  |  ε={ABLATION_EPSILON}  |  Seeds={ABLATION_SEEDS}\")\n",
    "print(f\"{'─'*72}\")\n",
    "\n",
    "for seed in ABLATION_SEEDS:\n",
    "    print(f\"\\n── Seed {seed} ──\")\n",
    "    for vname, vlabel in VARIANTS:\n",
    "        acc, f1, pf = run_ablation_variant(\n",
    "            vname, warmstart_weights, seed, ABLATION_EPSILON, ABLATION_ROUNDS\n",
    "        )\n",
    "        ablation_results[vname]['acc'].append(acc)\n",
    "        ablation_results[vname]['f1'].append(f1)\n",
    "        ablation_results[vname]['pf'].append(pf)\n",
    "        print(f\"  {vlabel:<42}  acc={acc:.4f}  f1={f1:.4f}  VP={pf[3]:.3f}\")\n",
    "\n",
    "\n",
    "# ── Summary table ─────────────────────────────────────────────────────────\n",
    "print(f\"\\n\\n{'='*80}\")\n",
    "print(f\"  ABLATION SUMMARY  (mean ± std over {len(ABLATION_SEEDS)} seeds, ε={ABLATION_EPSILON})\")\n",
    "print(f\"{'='*80}\")\n",
    "print(f\"  {'Variant':<42}  {'Accuracy':>14}  {'Macro F1':>14}  {'VP F1':>12}\")\n",
    "print(f\"  {'─'*42}  {'─'*14}  {'─'*14}  {'─'*12}\")\n",
    "\n",
    "summary = {}\n",
    "for vname, vlabel in VARIANTS:\n",
    "    accs = np.array(ablation_results[vname]['acc'])\n",
    "    f1s  = np.array(ablation_results[vname]['f1'])\n",
    "    vps  = np.array([pf[3] for pf in ablation_results[vname]['pf']])\n",
    "    summary[vname] = {'acc': accs, 'f1': f1s, 'vp': vps}\n",
    "    print(f\"  {vlabel:<42}  \"\n",
    "          f\"{accs.mean():.4f}±{accs.std():.4f}  \"\n",
    "          f\"{f1s.mean():.4f}±{f1s.std():.4f}  \"\n",
    "          f\"{vps.mean():.4f}±{vps.std():.4f}\")\n",
    "\n",
    "\n",
    "# ── Per-seed breakdown ────────────────────────────────────────────────────\n",
    "print(f\"\\n\\n{'='*80}\")\n",
    "print(f\"  PER-SEED BREAKDOWN\")\n",
    "print(f\"{'='*80}\")\n",
    "print(f\"  {'Seed':<6}  {'Variant':<42}  {'Acc':>7}  {'F1':>7}  {'VP F1':>7}\")\n",
    "print(f\"  {'─'*6}  {'─'*42}  {'─'*7}  {'─'*7}  {'─'*7}\")\n",
    "for s_idx, seed in enumerate(ABLATION_SEEDS):\n",
    "    for vname, vlabel in VARIANTS:\n",
    "        acc = ablation_results[vname]['acc'][s_idx]\n",
    "        f1  = ablation_results[vname]['f1'][s_idx]\n",
    "        vp  = ablation_results[vname]['pf'][s_idx][3]\n",
    "        print(f\"  {seed:<6}  {vlabel:<42}  {acc:.4f}  {f1:.4f}  {vp:.4f}\")\n",
    "    print()\n",
    "\n",
    "\n",
    "# ── Incremental signal contribution ──────────────────────────────────────\n",
    "print(f\"  INCREMENTAL SIGNAL CONTRIBUTION  (Δ over previous variant, mean across seeds)\")\n",
    "print(f\"  {'─'*64}\")\n",
    "vnames  = [v for v, _ in VARIANTS]\n",
    "signals = ['α_vol', 'α_round', 'α_conv']\n",
    "for i in range(1, len(vnames)):\n",
    "    delta_f1  = summary[vnames[i]]['f1'].mean()  - summary[vnames[i-1]]['f1'].mean()\n",
    "    delta_vp  = summary[vnames[i]]['vp'].mean()  - summary[vnames[i-1]]['vp'].mean()\n",
    "    delta_acc = summary[vnames[i]]['acc'].mean()  - summary[vnames[i-1]]['acc'].mean()\n",
    "    print(f\"  Adding {signals[i-1]:<12}  \"\n",
    "          f\"ΔAcc={delta_acc:+.4f}  ΔMacro F1={delta_f1:+.4f}  ΔVP F1={delta_vp:+.4f}\")\n",
    "\n",
    "\n",
    "# ── Per-seed advantage: full vs fixed ────────────────────────────────────\n",
    "print(f\"\\n  PER-SEED ADVANTAGE  (full method vs Fixed DP-FedAvg)\")\n",
    "print(f\"  {'─'*56}\")\n",
    "print(f\"  {'Seed':<6}  {'ΔMacro F1':>10}  {'ΔVP F1':>10}  {'F1 Win':>8}  {'VP Win':>8}\")\n",
    "for s_idx, seed in enumerate(ABLATION_SEEDS):\n",
    "    f1_full  = ablation_results['full']['f1'][s_idx]\n",
    "    f1_fixed = ablation_results['fixed']['f1'][s_idx]\n",
    "    vp_full  = ablation_results['full']['pf'][s_idx][3]\n",
    "    vp_fixed = ablation_results['fixed']['pf'][s_idx][3]\n",
    "    f1_win   = 'OURS ✓' if f1_full  > f1_fixed  else 'Fixed ✗'\n",
    "    vp_win   = 'OURS ✓' if vp_full  > vp_fixed  else 'Fixed ✗'\n",
    "    print(f\"  {seed:<6}  {f1_full-f1_fixed:>+10.4f}  {vp_full-vp_fixed:>+10.4f}  \"\n",
    "          f\"{f1_win:>8}  {vp_win:>8}\")\n",
    "\n",
    "f1_wins = sum(1 for i in range(len(ABLATION_SEEDS))\n",
    "              if ablation_results['full']['f1'][i] > ablation_results['fixed']['f1'][i])\n",
    "vp_wins = sum(1 for i in range(len(ABLATION_SEEDS))\n",
    "              if ablation_results['full']['pf'][i][3] > ablation_results['fixed']['pf'][i][3])\n",
    "print(f\"\\n  Win rate — Macro F1: {f1_wins}/{len(ABLATION_SEEDS)}  |  \"\n",
    "      f\"VP F1: {vp_wins}/{len(ABLATION_SEEDS)}\")\n",
    "\n",
    "\n",
    "# ── Save ──────────────────────────────────────────────────────────────────\n",
    "ablation_out = {\n",
    "    vname: {\n",
    "        'label':    vlabel,\n",
    "        'acc_mean': float(np.mean(ablation_results[vname]['acc'])),\n",
    "        'acc_std':  float(np.std(ablation_results[vname]['acc'])),\n",
    "        'f1_mean':  float(np.mean(ablation_results[vname]['f1'])),\n",
    "        'f1_std':   float(np.std(ablation_results[vname]['f1'])),\n",
    "        'vp_mean':  float(np.mean([pf[3] for pf in ablation_results[vname]['pf']])),\n",
    "        'vp_std':   float(np.std([pf[3] for pf in ablation_results[vname]['pf']])),\n",
    "        'raw':      ablation_results[vname],\n",
    "    }\n",
    "    for vname, vlabel in VARIANTS\n",
    "}\n",
    "with open(f\"{RESULTS_DIR}/ablation_seed_study.json\", \"w\") as f:\n",
    "    json.dump(ablation_out, f, indent=2)\n",
    "print(f\"\\nSaved → {RESULTS_DIR}/ablation_seed_study.json\")\n",
    "\n",
    "\n",
    "# ── Plot ──────────────────────────────────────────────────────────────────\n",
    "fig, axes = plt.subplots(1, 3, figsize=(16, 5))\n",
    "fig.suptitle(\n",
    "    f\"Ablation Study — Signal Contribution  (ε={ABLATION_EPSILON}, {len(ABLATION_SEEDS)} seeds)\",\n",
    "    fontweight='bold'\n",
    ")\n",
    "\n",
    "colors  = ['#6B7280', '#60A5FA', '#F59E0B', '#10B981']\n",
    "x       = np.arange(len(VARIANTS))\n",
    "xlabels = ['Fixed\\nDP-FedAvg', 'α_vol\\nonly', 'α_vol ×\\nα_round', 'Full\\n(ours)']\n",
    "metrics = [\n",
    "    ('acc', 'Accuracy', axes[0]),\n",
    "    ('f1',  'Macro F1', axes[1]),\n",
    "    ('vp',  'VP F1',    axes[2]),\n",
    "]\n",
    "\n",
    "for metric, ylabel, ax in metrics:\n",
    "    means = [summary[v][metric].mean() for v, _ in VARIANTS]\n",
    "    stds  = [summary[v][metric].std()  for v, _ in VARIANTS]\n",
    "    bars  = ax.bar(x, means, color=colors, edgecolor='white',\n",
    "                   yerr=stds, capsize=5, error_kw={'linewidth': 1.5})\n",
    "    for bar, m, s in zip(bars, means, stds):\n",
    "        ax.text(bar.get_x() + bar.get_width() / 2,\n",
    "                bar.get_height() + s + 0.008,\n",
    "                f\"{m:.3f}\", ha='center', va='bottom',\n",
    "                fontsize=9, fontweight='bold')\n",
    "    ax.set_xticks(x)\n",
    "    ax.set_xticklabels(xlabels, fontsize=9)\n",
    "    ax.set_ylabel(ylabel)\n",
    "    ax.set_title(f\"{ylabel} by Variant\")\n",
    "    ax.set_ylim(max(0, min(means) - max(stds) - 0.08),\n",
    "                max(means) + max(stds) + 0.07)\n",
    "    ax.grid(True, alpha=0.3, axis='y')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(f\"{RESULTS_DIR}/plots/ablation_study.png\", dpi=300, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(f\"Saved → {RESULTS_DIR}/plots/ablation_study.png\")"
   ]
  },
