    "def focal_loss(logits, targets, class_weights, gamma=3.0):\n",
    "    \"\"\"\n",
    "    Focal Loss with gamma=3.0 (was 2.0).\n",
    "\n",
    "    Why gamma=3.0 for VP recovery:\n",
    "      With weighted sampler, each batch has ~16 VP samples (25% of 64).\n",
    "      gamma=2.0: modulation factor for a well-predicted sample (p=0.9) is 0.01\n",
    "      gamma=3.0: modulation factor for the same sample is 0.001 — 10x more\n",
    "                 suppression of easy majority-class samples.\n",
    "      Net effect: VP gradients are proportionally larger before reaching\n",
    "      the DP clipper at max_grad_norm=1.0, so more VP signal survives clipping.\n",
    "\n",
    "      Lin et al. (ICCV 2017) show gamma=3-5 optimal for severe imbalance.\n",
    "      gamma=3 is the safe choice — aggressive but not destabilising.\n",
    "    \"\"\"\n",
    "    ce   = F.cross_entropy(logits, targets,\n",
    "                           weight    = class_weights,\n",
    "                           reduction = \"none\")\n",
    "    pt   = torch.exp(-ce)\n",
    "    loss = ((1 - pt) ** gamma) * ce\n",
    "    return loss.mean()\n"
   ]
  },
