    "# ── CELL 4b: Repartition helper ───────────────────────────────────────────\n",
    "import numpy as np\n",
    "\n",
    "_all_feat = np.concatenate([client_features[c] for c in range(NUM_CLIENTS)], axis=0)\n",
    "_all_lab  = np.concatenate([client_labels[c]   for c in range(NUM_CLIENTS)], axis=0)\n",
    "\n",
    "DIRICHLET_ALPHA  = 0.5\n",
    "CLIENT_DOMINANCE = {\n",
    "    0: {\"class\": 0, \"ratio\": 0.70},\n",
    "    1: {\"class\": 1, \"ratio\": 0.70},\n",
    "    2: {\"class\": 3, \"ratio\": 0.70},\n",
    "}\n",
    "\n",
    "def repartition_features(all_feat, all_lab, seed):\n",
    "    rng = np.random.RandomState(seed)\n",
    "    pools = {}\n",
    "    for label in range(N_CLASSES):\n",
    "        idx = np.where(all_lab == label)[0]\n",
    "        idx = idx[rng.permutation(len(idx))]\n",
    "        pools[label] = list(idx)\n",
    "\n",
    "    vp_count     = len(pools[3])\n",
    "    client_c_max = int(vp_count / 0.70)\n",
    "    assigned     = {0: [], 1: [], 2: []}\n",
    "\n",
    "    c_dom = CLIENT_DOMINANCE[2][\"class\"]\n",
    "    assigned[2].extend(pools[c_dom])\n",
    "    pools[c_dom] = []\n",
    "    c_remaining = client_c_max - len(assigned[2])\n",
    "    non_vp = [l for l in range(N_CLASSES) if l != c_dom]\n",
    "    if c_remaining > 0:\n",
    "        props = rng.dirichlet([DIRICHLET_ALPHA] * len(non_vp))\n",
    "        for i, label in enumerate(non_vp):\n",
    "            n_take = min(int(round(props[i] * c_remaining)), len(pools[label]))\n",
    "            assigned[2].extend(pools[label][:n_take])\n",
    "            pools[label] = pools[label][n_take:]\n",
    "    assigned[2] = assigned[2][:client_c_max]\n",
    "\n",
    "    for cid in [0, 1]:\n",
    "        dom   = CLIENT_DOMINANCE[cid][\"class\"]\n",
    "        ratio = CLIENT_DOMINANCE[cid][\"ratio\"]\n",
    "        dom_imgs = pools[dom][:]\n",
    "        assigned[cid].extend(dom_imgs)\n",
    "        pools[dom] = []\n",
    "        non_dom_need = int(len(dom_imgs) / ratio) - len(dom_imgs)\n",
    "        other = [l for l in range(N_CLASSES) if l != dom and len(pools[l]) > 0]\n",
    "        if other and non_dom_need > 0:\n",
    "            props = rng.dirichlet([DIRICHLET_ALPHA] * len(other))\n",
    "            for i, label in enumerate(other):\n",
    "                n_take = min(int(round(props[i] * non_dom_need)), len(pools[label]))\n",
    "                assigned[cid].extend(pools[label][:n_take])\n",
    "                pools[label] = pools[label][n_take:]\n",
    "\n",
    "    leftover = []\n",
    "    for label in pools:\n",
    "        leftover.extend(pools[label])\n",
    "    if leftover:\n",
    "        rng.shuffle(leftover)\n",
    "        sizes  = [len(assigned[c]) for c in range(3)]\n",
    "        total_sz = sum(sizes)\n",
    "        shares = [s / total_sz for s in sizes]\n",
    "        start  = 0\n",
    "        for cid in range(3):\n",
    "            if cid == 2:\n",
    "                assigned[cid].extend(leftover[start:])\n",
    "            else:\n",
    "                n_chunk = int(round(shares[cid] * len(leftover)))\n",
    "                assigned[cid].extend(leftover[start:start + n_chunk])\n",
    "                start += n_chunk\n",
    "\n",
    "    feats_out  = {cid: all_feat[np.array(assigned[cid])] for cid in range(3)}\n",
    "    labels_out = {cid: all_lab[np.array(assigned[cid])]  for cid in range(3)}\n",
    "    return feats_out, labels_out\n",
    "\n",
    "# Sanity check\n",
    "print(\"Repartition sanity check:\")\n",
    "for s in [0, 7, 42, 123, 999]:\n",
    "    f, l = repartition_features(_all_feat, _all_lab, s)\n",
    "    print(f\"  seed={s}  A={len(f[0])}  B={len(f[1])}  C={len(f[2])}\")"
   ]
