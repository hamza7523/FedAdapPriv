    "EPOCH_CAP = 3\n",
    "_avg_actual_epochs = sum(\n",
    "    min(EPOCH_CAP, max(1, round(LOCAL_EPOCHS * (r / NUM_ROUNDS))))\n",
    "    for r in range(1, NUM_ROUNDS + 1)\n",
