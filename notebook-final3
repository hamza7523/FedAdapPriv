pe":"code","source":"import warnings, logging\nwarnings.filterwarnings(\"ignore\", message=\".*drop_last.*\")\nlogging.getLogger(\"opacus\").setLevel(logging.ERROR)\n\nfrom opacus.utils.batch_memory_manager import BatchMemoryManager\n\n\ndef local_train_dp(global_weights, features, labels, client_id,\n                   local_epochs_actual, clip_norm_actual,\n                   epsilon_total,\n                   batch_size    = BATCH_SIZE_PHYSICAL,\n                   lr            = None,\n                   device        = DEVICE,\n                   track_privacy = True,\n                   **kwargs):\n    \"\"\"\n    Local DP training.\n      [A] DP-Adam (USE_ADAM=True): adaptive per-param LR, stable under noise.\n      [B] DP-SGD  (USE_ADAM=False): epoch-coupled LR (base/E_r) keeps\n          gradient displacement constant as epoch schedule ramps.\n      [C] Focal loss + weighted sampler: minority class preservation.\n      [D] BatchMemoryManager: physical/logical batch separation for Opacus.\n      [E] Manual RDP .step() accumulation: correct cross-round ε composition.\n    \"\"\"\n    model = MLPClassifier().to(device)\n    model.load_state_dict(global_weights)\n    model.train()\n\n    loader = make_weighted_loader(features, labels, batch_size)\n\n    # ── [A/B] Optimizer and LR ────────────────────────────────\n    if USE_ADAM:\n        effective_lr = ADAM_LR\n        optimizer    = torch.optim.Adam(\n            model.parameters(),\n            lr=effective_lr, betas=(0.9, 0.999), eps=1e-8, weight_decay=1e-4)\n    else:\n        base_lr      = lr if lr is not None else 0.01\n        effective_lr = base_lr / local_epochs_actual\n        optimizer    = torch.optim.SGD(\n            model.parameters(),\n            lr=effective_lr, momentum=0.9, weight_decay=1e-4)\n\n    if len(loader) == 0:\n        return get_weights(model), 0.0\n\n    sigma = get_or_compute_sigma(\n        client_id     = client_id,\n        n_samples     = len(features),\n        epsilon_total = epsilon_total,\n    )\n\n    pe = PrivacyEngine(accountant=\"rdp\")\n    model, optimizer, loader = pe.make_private(\n        module           = model,\n        optimizer        = optimizer,\n        data_loader      = loader,\n        noise_multiplier = sigma,\n        max_grad_norm    = clip_norm_actual,\n    )\n\n    cw = CLASS_WEIGHTS_TENSOR.to(device)\n    total_loss, steps = 0.0, 0\n\n    for _ in range(local_epochs_actual):\n        with BatchMemoryManager(\n            data_loader             = loader,\n            max_physical_batch_size = batch_size,\n            optimizer               = optimizer,\n        ) as safe_loader:\n            for x, y in safe_loader:\n                x, y = x.to(device), y.to(device)\n                optimizer.zero_grad()\n                loss = focal_loss(model(x), y, class_weights=cw, gamma=2.0)\n                loss.backward()\n                optimizer.step()\n                total_loss += loss.item()\n                steps      += 1\n\n    # ── [E] RDP accounting: manual cross-round accumulation ───\n    # pe.get_epsilon() only covers this round's fresh PrivacyEngine.\n    # We accumulate into the external accountant for full composition.\n    if track_privacy:\n        # Count LOGICAL steps only (one per optimizer.step() call),\n        # not micro-batch steps inflated by BatchMemoryManager.\n        sample_rate   = batch_size / len(features)\n        steps_per_epoch = math.ceil(len(features) / batch_size)\n        logical_steps   = local_epochs_actual * steps_per_epoch\n        for _ in range(logical_steps):\n            client_accountants[client_id].step(\n                noise_multiplier = sigma,\n                sample_rate      = sample_rate,\n            )\n\n    return get_weights(model), total_loss / max(steps, 1)\n\n\nprint(f\"local_train_dp defined.\")\nprint(f\"  Optimizer : {'DP-Adam lr=' + str(ADAM_LR) if USE_ADAM else 'DP-SGD epoch-coupled'}\")\nprint(f\"  Focal loss active  |  BatchMemoryManager ac