RAD_NORM/noise_std:.3f}\")\n    return sigma\n\n\ndef report_privacy_spent(delta=DELTA, verbose=True):\n    \"\"\"\n    Query cumulative ε per client from RDP accountant.\n    Steps accumulated via manual .step() calls in local_train_dp —\n    this gives correct cross-round composition.\n    \"\"\"\n    results = {}\n    if verbose:\n        print(\"\\n── Privacy Budget Report (RDP accountant) ──\")\n    for cid in range(NUM_CLIENTS):\n        acc = client_accountants[cid]\n        if len(acc.history) == 0:\n            if verbose:\n                print(f\"  Client {client_names[cid]}: no steps recorded\")\n            results[cid] = 0.0\n            continue\n        eps = float(acc.get_epsilon(delta=delta))\n        results[cid] = eps\n        status = \"✓\" if eps <= EPSILON_MAIN + 0.15 else \"⚠ OVER BUDGET\"\n        if verbose:\n            print(f\"  Client {client_names[cid]}: ε_spent={eps:.4f} \"\n                  f\"/ ε_main={EPSILON_MAIN}  {status}\")\n    if verbose:\n        print(f\"  ε_warmstart={EPSILON_WARMSTART} [public backbone] \"\n              f\"→ ε_total_claimed={EPSILON_TOTAL}\")\n    return results\n\n\n# Print sigma values immediately\nprint(\"\\nσ values (ε_main=3.0, full budget):\")\nfor cid in range(NUM_CLIENTS):\n    get_or_compute_sigma(cid, client_sizes[cid], EPSILON_MAIN)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-23T09:10:10.487178Z","iopub.execute_input":"2026-05-23T09:10:10.487789Z","iopub.status.idle":"2026-05-23T09:10:10.958180Z","shell.execute_reply.started":"2026-05-23T09:10:10.487759Z","shell.execute_reply":"2026-05-23T09:10:10.957491Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import warnings, logging\nwarnings.filterwarnings(\"ignore\", message=\".*drop_last.*\")\nlogging.getLogger(\"opacus\").setLevel(logging.ERROR)\n\nfrom opacus.utils.batch_memory_manager import BatchMemoryManager\n\n\ndef local_train_dp(global_weights, features, labels, client_id,\n                   local_epochs_actual, clip_norm_actual,\n                   epsilon_total,\n                   batch_size    = BATCH_SIZE_PHYSICAL,\n                   lr            = None,\n                   device        = DEVICE,\n                   track_privacy = True,\n                   **kwargs):\n    \"\"\"\n    Local DP training.\n      [A] DP-Adam (USE_ADAM=True): adaptive per-param LR, stable under noise.\n      [B] DP-SGD  (USE_ADAM=False): epoch-coupled LR (base/E_r) keeps\n          gradient displacement constant as epoch schedule ramps.\n      [C] Focal loss + weighted sampler: minority class preservation.\n      [D] BatchMemoryManager: physical/logical batch separation for Opacus.\n      [E] Manual RDP .step() accumulation: correct cross-round ε composition.\n    \"\"\"\n    model = MLPClassifier().to(device)\n    model.load_state_dict(global_weights)\n    model.train()\n\n    loader = make_weighted_loader(features, labels, batch_size)\n\n    # ── [A/B] Optimizer and LR ────────────────────────────────\n    if USE_ADAM:\n        effective_lr = ADAM_LR\n        optimizer    = torch.optim.Adam(\n            model.parameters(),\n            lr=effective_lr, betas=(0.9, 0.999), eps=1e-8, weight_decay=1e-4)\n    else:\n        base_lr      = lr if lr is not None else 0.01\n        effective_lr = base_lr / local_epochs_actual\n        optimizer    = torch.optim.SGD(\n            model.parameters(),\n            lr=effective_lr, momentum=0.9, weight_decay=1e-4)\n\n    if len(loader) == 0:\n        return get_weights(model), 0.0\n\n    sigma = get_or_compute_sigma(\n        client_id     = client_id,\n        n_samples     = len(features),\n        epsilon_total = epsilon_total,\n    )\n\n    pe = PrivacyEngine(accountant=\"rdp\")\n    model, optimizer, loader = pe.make_private(\n        module           = model,\n        optimizer        = optimizer,\n        data_loader      = loader,\n        noise_multiplier = sigma,\n        max_grad_norm    = clip_norm_actual,\n    )\n\n    cw = CLASS_WEIGHTS_TENSOR.to(device)\n    total_loss, steps = 0.0, 0\n\n    for _ in range(local_epochs_actual):\n        with BatchMemoryManager(\n            data_loader             = loader,\n            max_physical_batch_size = batch_size,\n            optimizer               = optimizer,\n        ) as safe_loader:\n            for x, y in safe_loader:\n                x, y = x.to(device), y.to(device)\n                optimizer.zero_grad()\n                loss = focal_loss(model(x), y, class_weights=cw, gamma=2.0)\n                loss.backward()\n                optimizer.step()\n                total_loss += loss.item()\n                steps      += 1\n\n    # ── [E] RDP accounting: manual cross-round accumulation ───\n    # pe.get_epsilon() only covers this round's fresh PrivacyEngine.\n    # We accumulate into the external accountant for full composition.\n    if track_privacy:\n        # Count LOGICAL steps only (one per optimizer.step() call),\n        # not micro-batch steps inflated by BatchMemoryManager.\n        sample_rate   = batch_size / len(features)\n        steps_per_epoch = math.ceil(len(features) / batch_size)\n        logical_steps   = local_epochs_actual * steps_per_epoch\n        for _ in range(logical_steps):\n            client_accountants[client_id].step(\n                noise_multiplier = sigma,\n                sample_rate      = sample_rate,\n            )\n\n    return get_weights(model), total_loss / max(steps, 1)\n\n\nprint(f\"local_train_dp defined.\")\nprint(f\"  Optimizer : {'DP-Adam lr=' + str(ADAM_LR) if USE_ADAM else 'DP-SGD epoch-coupled'}\")\nprint(f\"  Focal loss active  |  BatchMemoryManager active\")\nprint(f\"  ε_main={EPSILON_MAIN} (full budget, warmstart=0.0)\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-23T09:10:13.900403Z","iopub.execute_input":"2026-05-23T09:10:13.900693Z","iopub.status.idle":"2026-05-23T09:10:13.914005Z","shell.execute_reply.started":"2026-05-23T09:10:13.900671Z","shell.execute_reply":"2026-05-23T09:10:13.913103Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def run_federated_adaptive(\n    warmstart_weights,\n    epsilon_total = EPSILON_MAIN,\n    num_rounds    = NUM_ROUNDS,\n    verbose       = True,\n):\n    \"\"\"\n    3-Signal Adaptive DP-FL — VP-optimised variant.\n\n    VP recovery fixes:\n      [1] LAMBDA=2.0 in config → Client C gets 2x more aggregation\n          weight when VP deficiency is high (vs LAMBDA=1.0).\n      [2] Per-client epoch cap: Client C capped at E=2 (SNR=0.449),\n          Clients A/B capped at E=3 (SNR=0.65+). Reduces Client C's\n          noise accumulation by 33% per round without hurting A/B.\n      [3] gamma=3.0 in focal_loss → stronger VP gradient amplification.\n      [4] ADAM_LR=2e-4 → faster VP signal propagation.\n    \"\"\"\n    reset_accountants()\n    torch.manual_seed(RANDOM_SEED)\n    np.random.seed(RANDOM_SEED)\n\n    global_weights = copy.deepcopy(warmstart_weights)\n\n    history = {\n        \"round_acc\":          [],\n        \"round_f1\":           [],\n        \"best_f1\":            0.0,\n        \"best_round\":         1,\n        \"best_weights\":       None,\n        \"client_loss\":        {cid: [] for cid in range(NUM_CLIENTS)},\n        \"client_defic\":       {cid: [] for cid in range(NUM_CLIENTS)},\n        \"client_epochs\":      {cid: [] for cid in range(NUM_CLIENTS)},\n        \"client_alpha_vol\":   {cid: [] for cid in range(NUM_CLIENTS)},\n        \"client_alpha_conv\":  {cid: [] for cid in range(NUM_CLIENTS)},\n        \"client_alpha_round\": {cid: [] for cid in range(NUM_CLIENTS)},\n        \"epsilon_total\":      epsilon_total,\n    }\n\n    # Per-client epoch caps based on SNR\n    # Client A: n=6158, σ=1.53, SNR=0.65 → can handle E=3\n    # Client B: n=9249, σ=1.30, SNR=0.77 → can handle E=3\n    # Client C: n=2581, σ=2.23, SNR=0.45 → cap at E=2 to protect VP\n    CLIENT_EPOCH_CAPS = {0: 3, 1: 3, 2: 2}\n    LATE_ROUND_CAP    = 25   # from this round, cap A/B at E=2 also\n\n\n    for rnd in range(1, num_rounds + 1):\n        weights_list, agg_weights, sizes = [], [], []\n\n        for cid in range(NUM_CLIENTS):\n            defic = compute_deficiency(\n                global_weights,\n                client_features[cid], client_labels[cid])\n\n            local_ep, clip_n, agg_w, alphas = compute_training_intensity(\n                cid, rnd, defic, client_sizes, n_max, num_rounds)\n\n            # [2] Per-client epoch cap based on SNR\n            # Late-round: reduce A/B epochs to prevent VP signal dilution\n            if rnd >= LATE_ROUND_CAP and cid in [0, 1]:\n                local_ep = min(local_ep, 2)\n            else:\n                local_ep = min(local_ep, CLIENT_EPOCH_CAPS[cid])\n\n            history[\"client_alpha_vol\"][cid].append(alphas[0])\n            history[\"client_alpha_conv\"][cid].append(alphas[1])\n            history[\"client_alpha_round\"][cid].append(alphas[2])\n            history[\"client_defic\"][cid].append(defic)\n            history[\"client_epochs\"][cid].append(local_ep)\n\n            w, loss = local_train_dp(\n                global_weights,\n                client_features[cid], client_labels[cid],\n                client_id           = cid,\n                local_epochs_actual = local_ep,\n                clip_norm_actual    = clip_n,\n                epsilon_total       = epsilon_total,\n            )\n            history[\"client_loss\"][cid].append(loss)\n            weights_list.append(w)\n            agg_weights.append(agg_w)\n            sizes.append(client_sizes[cid])\n\n        global_weights = adaptive_fedavg(\n            weights_list, agg_weights, sizes, privatise=True)\n\n\n        acc, f1, per_f1 = evaluate(global_weights, test_features, test_labels)\n        history[\"round_acc\"].append(acc)\n        history[\"round_f1\"].append(f1)\n        \n\n        # Use macro F1 as primary, VP F1 as tiebreaker\n        # VP is the minority class — a model that sacrifices VP for macro\n        # is not what this paper claims to solve\n        vp_f1 = per_f1[3]\n        score = f1 + 0.3 * vp_f1   # weighted composite: macro + VP bonus\n\n        if score > history.get(\"best_score\", 0.0):\n            \n            history[\"best_score\"]   = score\n            history[\"best_f1\"]      = f1\n            history[\"best_round\"]   = rnd\n            history[\"best_weights\"] = copy.deepcopy(global_weights)\n        if verbose:\n            ep_str = \"  \".join(\n                f\"{client_names[c]}:E={history['client_epochs'][c][-1]}\"\n                for c in range(NUM_CLIENTS))\n            print(f\"r={rnd:2d} | acc={acc:.4f}  f1={f1:.4f}  \"\n                  f\"VP={per_f1[3]:.3f}  COVID={per_f1[0]:.3f} | {ep_str}\")\n\n    history[\"final_weights\"] = global_weights\n\n    raw_swing = max(abs(history[\"round_acc\"][i] - history[\"round_acc\"][i-1])\n                    for i in range(1, len(history[\"round_acc\"])))\n    print(f\"\\n  Raw swing  : {raw_swing:.4f}  \"\n          f\"{'✓ Stable' if raw_swing <= 0.12 else '⚠ Consider lower ADAM_LR'}\")\n    print(f\"  Best round : {history['best_round']}  F1={history['best_f1']:.4f}\")\n\n    return history\n\n\nprint(\"run_federated_adaptive defined  [VP-optimised]\")\nprint(f\"  LAMBDA={LAMBDA}  |  Client C EPOCH_CAP=2  |  gamma=3.0  |  lr={ADAM_LR}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-23T09:10:17.205229Z","iopub.execute_input":"2026-05-23T09:10:17.206014Z","iopub.status.idle":"2026-05-23T09:10:17.219463Z","shell.execute_reply.started":"2026-05-23T09:10:17.205981Z","shell.execute_reply":"2026-05-23T09:10:17.218625Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── Sanity check — DPLinearProbe should not exist ─────────────────────────\nassert 'DPLinearProbe' not in dir(), \\\n    \"DPLinearProbe still in namespace — find and remove it\"\nprint(\"Clean — no DPLinearProbe in namespac