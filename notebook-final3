    "# ── STATISTICAL SIGNIFICANCE: 3 Partition Seeds ──────────────────────────────\n",
    "import numpy as np, json, copy, torch, __main__\n",
    "from scipy import stats\n",
    "\n",
    "PARTITION_SEEDS = [42, 137, 256]\n",
    "EPSILON_SIG     = 3.0\n",
    "ROUNDS_SIG      = 30\n",
    "\n",
    "# ── helpers ───────────────────────────────────────────────────────────────────\n",
    "def _set_globals(feat, lab, siz):\n",
    "    \"\"\"Push client data into __main__ so all functions in other cells see it.\"\"\"\n",
    "    __main__.client_features = feat\n",
    "    __main__.client_labels   = lab\n",
    "    __main__.client_sizes    = siz\n",
    "    __main__.n_max           = max(siz.values())   # ← keep n_max consistent with sizes\n",
    "\n",
    "def _get_vp_f1(res):\n",
    "    \"\"\"Extract VP F1 at best round — works for both adaptive and fixed.\"\"\"\n",
    "    if \"round_vp_f1\" in res:\n",
    "        return float(res[\"round_vp_f1\"][res[\"best_round\"] - 1])\n",
    "    # run_fixed_dp_fedavg has no round_vp_f1 → re-evaluate at best weights\n",
    "    best_w = res[\"best_weights\"] if res.get(\"best_weights\") is not None else res[\"final_weights\"]\n",
    "    _, _, per_f1 = evaluate(best_w, test_features, test_labels)\n",
    "    return float(per_f1[3])\n",
    "\n",
    "def dirichlet_partition(features, labels, seed, alpha=0.5, dominant_frac=0.70):\n",
    "    rng          = np.random.default_rng(seed)\n",
    "    dominant_map = {0: 0, 1: 1, 2: 3}          # client → dominant class\n",
    "    class_idx    = {c: np.where(labels == c)[0].copy() for c in range(NUM_CLASSES)}\n",
    "    client_idx   = [[] for _ in range(NUM_CLIENTS)]\n",
    "\n",
    "    for cid, dom_cls in dominant_map.items():\n",
    "        idx = class_idx[dom_cls].copy();  rng.shuffle(idx)\n",
    "        n_dom = int(len(idx) * dominant_frac)\n",
    "        client_idx[cid].extend(idx[:n_dom].tolist())\n",
    "        class_idx[dom_cls] = idx[n_dom:]\n",
    "\n",
    "    for c in range(NUM_CLASSES):\n",
    "        pool = class_idx[c]\n",
    "        if len(pool) == 0: continue\n",
    "        props  = rng.dirichlet(alpha * np.ones(NUM_CLIENTS))\n",
    "        rng.shuffle(pool)\n",
    "        splits = (props * len(pool)).astype(int)\n",
    "        splits[-1] = len(pool) - splits[:-1].sum()\n",
    "        ptr = 0\n",
    "        for k in range(NUM_CLIENTS):\n",
    "            client_idx[k].extend(pool[ptr:ptr+splits[k]].tolist())\n",
    "            ptr += splits[k]\n",
    "\n",
    "    feat_d, lab_d, size_d = {}, {}, {}\n",
    "    for k in range(NUM_CLIENTS):\n",
    "        idx_k = np.array(client_idx[k]);  rng.shuffle(idx_k)\n",
    "        feat_d[k] = torch.tensor(features[idx_k], dtype=torch.float32)\n",
    "        lab_d[k]  = torch.tensor(labels[idx_k],   dtype=torch.long)\n",
    "        size_d[k] = len(idx_k)\n",
    "        vp  = (labels[idx_k] == 3).sum() / len(idx_k)\n",
    "        cov = (labels[idx_k] == 0).sum() / len(idx_k)\n",
    "        print(f\"    Client {k}: n={len(idx_k):5d}  VP={vp:.1%}  COVID={cov:.1%}\")\n",
    "    return feat_d, lab_d, size_d\n",
    "\n",
    "# ── snapshot originals ────────────────────────────────────────────────────────\n",
    "_orig_feat  = {k: __main__.client_features[k] for k in range(NUM_CLIENTS)}\n",
    "_orig_lab   = {k: __main__.client_labels[k]   for k in range(NUM_CLIENTS)}\n",
    "_orig_sizes = dict(__main__.client_sizes)\n",
    "\n",
    "# ── build full training pool from original globals ────────────────────────────\n",
    "_pool_feat = np.vstack([\n",
    "    _orig_feat[k].numpy() if hasattr(_orig_feat[k], 'numpy') else _orig_feat[k]\n",
    "    for k in range(NUM_CLIENTS)\n",
    "])\n",
    "_pool_lab = np.concatenate([\n",
    "    _orig_lab[k].numpy() if hasattr(_orig_lab[k], 'numpy') else _orig_lab[k]\n",
    "    for k in range(NUM_CLIENTS)\n",
    "])\n",
    "print(f\"Training pool: {_pool_feat.shape}  labels: {_pool_lab.shape}\")\n",
    "\n",
    "_ws = copy.deepcopy(warmstart_weights)\n",
    "\n",
    "# ── storage ───────────────────────────────────────────────────────────────────\n",
    "sig_results = {\n",
    "    \"adaptive\": {\"macro_f1\": [], \"vp_f1\": [], \"acc\": []},\n",
    "    \"fixed\":    {\"macro_f1\": [], \"vp_f1\": [], \"acc\": []},\n",
    "    \"partition_seeds\": PARTITION_SEEDS,\n",
    "    \"epsilon\": EPSILON_SIG,\n",
    "}\n",
    "\n",
    "print(f\"\\nStatistical Significance | ε={EPSILON_SIG} | seeds={PARTITION_SEEDS}\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "for pseed in PARTITION_SEEDS:\n",
    "    print(f\"\\n── Partition seed {pseed} ──\")\n",
    "    feat_d, lab_d, size_d = dirichlet_partition(_pool_feat, _pool_lab, seed=pseed)\n",
    "    print(f\"  Sizes: {[size_d[k] for k in range(NUM_CLIENTS)]}\")\n",
    "\n",
    "    _set_globals(feat_d, lab_d, size_d)         # ← propagates client_sizes + n_max\n",
    "\n",
    "    # FedAdaPriv-CPU\n",
    "    print(\"  Running FedAdaPriv-CPU ...\")\n",
    "    reset_accountants()\n",
    "    res_adp = run_federated_adaptive(\n",
    "        copy.deepcopy(_ws), epsilon_total=EPSILON_SIG,\n",
    "        num_rounds=ROUNDS_SIG, verbose=False)\n",
    "\n",
    "    # Fixed DP-FedAvg\n",
    "    print(\"  Running Fixed DP-FedAvg ...\")\n",
    "    reset_accountants()\n",
    "    res_fix = run_fixed_dp_fedavg(\n",
    "        copy.deepcopy(_ws), epsilon_total=EPSILON_SIG,\n",
    "        num_rounds=ROUNDS_SIG, verbose=False)\n",
    "\n",
    "    # adaptive: \"best_f1\" / \"round_acc\" / \"best_round\" / \"round_vp_f1\" all present\n",
    "    sig_results[\"adaptive\"][\"macro_f1\"].append(res_adp[\"best_f1\"])\n",
    "    sig_results[\"adaptive\"][\"vp_f1\"].append(_get_vp_f1(res_adp))\n",
    "    sig_results[\"adaptive\"][\"acc\"].append(res_adp[\"round_acc\"][res_adp[\"best_round\"] - 1])\n",
    "\n",
    "    # fixed: same keys except no \"round_vp_f1\" → _get_vp_f1 calls evaluate() instead\n",
    "    sig_results[\"fixed\"][\"macro_f1\"].append(res_fix[\"best_f1\"])\n",
    "    sig_results[\"fixed\"][\"vp_f1\"].append(_get_vp_f1(res_fix))\n",
    "    sig_results[\"fixed\"][\"acc\"].append(res_fix[\"round_acc\"][res_fix[\"best_round\"] - 1])\n",
    "\n",
    "    print(f\"  Adaptive → F1={sig_results['adaptive']['macro_f1'][-1]:.4f}  \"\n",
    "          f\"VP={sig_results['adaptive']['vp_f1'][-1]:.4f}\")\n",
    "    print(f\"  Fixed    → F1={sig_results['fixed']['macro_f1'][-1]:.4f}  \"\n",
    "          f\"VP={sig_results['fixed']['vp_f1'][-1]:.4f}\")\n",
    "\n",
    "# ── restore originals ─────────────────────────────────────────────────────────\n",
    "_set_globals(_orig_feat, _orig_lab, _orig_sizes)\n",
    "print(\"\\nOriginals restored.\")\n",
    "\n",
    "# ── statistical tests ─────────────────────────────────────────────────────────\n",
    "adp_f1 = np.array(sig_results[\"adaptive\"][\"macro_f1\"])\n",
    "fix_f1 = np.array(sig_results[\"fixed\"][\"macro_f1\"])\n",
    "adp_vp = np.array(sig_results[\"adaptive\"][\"vp_f1\"])\n",
    "fix_vp = np.array(sig_results[\"fixed\"][\"vp_f1\"])\n",
    "\n",
    "t_f1, p_f1 = stats.ttest_rel(adp_f1, fix_f1)\n",
    "t_vp, p_vp = stats.ttest_rel(adp_vp, fix_vp)\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"SIGNIFICANCE RESULTS\")\n",
    "print(\"=\" * 70)\n",
    "print(f\"\\nMacro F1:\")\n",
    "print(f\"  FedAdaPriv-CPU : {adp_f1.mean():.4f} ± {adp_f1.std():.4f}  {adp_f1.tolist()}\")\n",
    "print(f\"  Fixed DP-FedAvg: {fix_f1.mean():.4f} ± {fix_f1.std():.4f}  {fix_f1.tolist()}\")\n",
    "print(f\"  Δ = +{adp_f1.mean()-fix_f1.mean():.4f} | t={t_f1:.3f} | p={p_f1:.4f}\",\n",
    "      \"✓ significant\" if p_f1 < 0.05 else \"✗ not significant at p<0.05\")\n",
    "\n",
